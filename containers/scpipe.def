# scpipe for Apptainer/Singularity: the published Docker image (containers/Dockerfile),
# so both runtimes get exactly the same software. Usually you only need
#
#   apptainer pull scpipe.sif docker://ghcr.io/mukeshkbj/scpipe:latest
#
# This file is for sites that build images from a definition file:
#
#   apptainer build scpipe.sif containers/scpipe.def
#   apptainer exec --nv scpipe.sif scpipe doctor --config config.yaml
#
# Run with --nv so the host GPU driver is used; point the site file at the image
# (container.runtime: apptainer, container.image: /path/to/scpipe.sif).
Bootstrap: docker
From: ghcr.io/mukeshkbj/scpipe:latest

%runscript
    exec scpipe "$@"

%test
    scpipe --help >/dev/null
    python -c "import scfast, scpipe"
