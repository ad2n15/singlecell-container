# scpipe single image for Apptainer/Singularity (docs/DESIGN.md 7.5).
#
#   apptainer build scpipe.sif containers/scpipe.def
#   apptainer exec --nv scpipe.sif scpipe doctor --config config.yaml
#
# Same software list as containers/Dockerfile: CUDA 12 Ubuntu base, R 4.4+
# with Seurat 5, BPCells, presto, DESeq2, limma, leidenbase, hdf5r, harmony;
# Rust engine (scfastR, scfast); Python 3.12 with the scpipe package [gpu,harmony] (rapids-singlecell,
# cupy/cudf/cuml for CUDA 12), CellTypist, jinja2, matplotlib. Not built in
# tests. Run with --nv so the host driver is used; set container.runtime:
# apptainer and container.image: /path/to/scpipe.sif in the site file.
Bootstrap: docker
From: nvidia/cuda:12.4.1-runtime-ubuntu22.04

%labels
    Maintainer scpipe
    Description Single-cell pipeline: Seurat 5 + rapids-singlecell + agents

%files
    python /opt/scpipe/python
    R /opt/scpipe/R
    conf /opt/scpipe/conf
    config /opt/scpipe/config
    docs /opt/scpipe/docs
    rust /opt/scpipe/rust

%environment
    export LANG=en_GB.UTF-8 LC_ALL=en_GB.UTF-8 TZ=Etc/UTC
    export PATH=/opt/scpipe-venv/bin:$PATH VIRTUAL_ENV=/opt/scpipe-venv
    export SCPIPE_REPO_ROOT=/opt/scpipe
    export RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
    export MPLCONFIGDIR=/tmp/mpl NUMBA_CACHE_DIR=/tmp/numba

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive R_VERSION=4.4.2 PYTHON_VERSION=3.12
    apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl wget gnupg locales tmux git build-essential gfortran \
      libhdf5-dev libcurl4-openssl-dev libssl-dev libxml2-dev libglpk-dev libgsl-dev \
      libpng-dev libjpeg-dev libtiff-dev libfontconfig1-dev libharfbuzz-dev libfribidi-dev \
      libfreetype6-dev libcairo2-dev libxt-dev libgit2-dev libzstd-dev liblzma-dev libbz2-dev \
      cmake pkg-config software-properties-common
    locale-gen en_GB.UTF-8

    # R 4.4 from CRAN's Ubuntu repository
    curl -fsSL https://cloud.r-project.org/bin/linux/ubuntu/marutter_pubkey.asc \
      > /etc/apt/trusted.gpg.d/cran_ubuntu_key.asc
    add-apt-repository -y "deb https://cloud.r-project.org/bin/linux/ubuntu jammy-cran40/"
    apt-get update && apt-get install -y --no-install-recommends "r-base=${R_VERSION}*" "r-base-dev=${R_VERSION}*"
    echo 'options(repos = c(CRAN = "https://packagemanager.posit.co/cran/__linux__/jammy/latest"), Ncpus = 4)' \
      > /usr/lib/R/etc/Rprofile.site
    Rscript -e 'install.packages(c("Seurat", "SeuratObject", "Matrix", "hdf5r", "jsonlite", "digest", "yaml", "optparse", "data.table", "R.utils", "harmony", "leidenbase", "uwot", "qs2", "remotes", "BiocManager", "testthat", "RhpcBLASctl", "glmGamPoi"))'
    Rscript -e 'BiocManager::install(c("DESeq2", "limma", "edgeR", "scDblFinder", "SingleR", "celldex", "BiocParallel"), update = FALSE, ask = FALSE)'
    Rscript -e 'remotes::install_github(c("bnprks/BPCells/r", "immunogenomics/presto", "satijalab/seurat-wrappers"), upgrade = "never")'
    Rscript -e 'for (p in c("Seurat","BPCells","presto","DESeq2","limma","leidenbase","hdf5r","harmony")) stopifnot(requireNamespace(p, quietly = TRUE))'

    # Python 3.12 + scpipe with GPU extras
    add-apt-repository -y ppa:deadsnakes/ppa && apt-get update
    apt-get install -y --no-install-recommends python${PYTHON_VERSION} python${PYTHON_VERSION}-venv python${PYTHON_VERSION}-dev
    python${PYTHON_VERSION} -m venv /opt/scpipe-venv
    . /opt/scpipe-venv/bin/activate
    pip install --no-cache-dir --upgrade pip wheel
    pip install --no-cache-dir --extra-index-url=https://pypi.nvidia.com \
      "/opt/scpipe/python[gpu,harmony,test]" jinja2 matplotlib requests pyyaml celltypist \
      "cupy-cuda12x" "cudf-cu12" "cuml-cu12" "cugraph-cu12"
    python -c "import scpipe, rapids_singlecell, harmonypy, celltypist, jinja2, matplotlib"

    # Rust engine (docs/scfast-integration.md): toolchain (cargo >= 1.80), scfastR for R, scfast for Python
    export RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
    curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
    cargo --version
    R CMD INSTALL /opt/scpipe/rust/scfast-r
    Rscript -e 'stopifnot(requireNamespace("scfastR", quietly = TRUE))'
    pip install --no-cache-dir maturin umap-learn
    maturin build --release -m /opt/scpipe/rust/scfast-py/Cargo.toml -o /tmp/wheels
    pip install --no-cache-dir /tmp/wheels/scfast-*.whl
    python -c "import scfast; print('scfast', scfast.__version__)"
    rm -rf /tmp/wheels /opt/scpipe/rust/target
    rm -rf /var/lib/apt/lists/* /tmp/*

%runscript
    exec scpipe "$@"

%test
    scpipe --help >/dev/null
    Rscript -e 'library(Seurat); cat("Seurat", as.character(packageVersion("Seurat")), "\n")'
